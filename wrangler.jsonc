{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "gestortrafego",
  "compatibility_date": "2026-08-28",
  "observability": {
    "enabled": true
  },
  "build": {
    "command": "bun run build"
  },
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  }
}
